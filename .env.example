# Mode demo: data disimpan di localStorage, tidak butuh backend.
# Set ke "false" untuk memakai API sungguhan.
VITE_USE_MOCK=true

# Base URL API. Default: /api
# VITE_API_URL=http://localhost:3000/api

# Opsional untuk development: teruskan request /api ke backend lokal.
# Bisa juga memakai VITE_API_URL langsung tanpa proxy.
# VITE_API_PROXY=http://localhost:3000
