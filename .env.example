# Mode demo (default): data disimpan di localStorage, tidak butuh backend.
# Set ke "false" untuk memakai API sungguhan.
VITE_USE_MOCK="true"

# Base URL API. Default: /api
VITE_API_URL=/api

# Khusus development: teruskan request /api ke backend.
# Tidak dipakai saat build/preview. Untuk mode API sungguhan, isi:
#   VITE_USE_MOCK="false"
#   VITE_API_PROXY=https://duitku-api-psi.vercel.app
VITE_API_PROXY=http://localhost:3000
